---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
// href and pathname both include the base, so compare them directly:
// exact match for the home link, prefix match for section links.
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const target = String(href);
const isActive = target === base ? pathname === base : pathname.startsWith(target);
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
